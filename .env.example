# ─────────────────────────────────────────────
#  Real-Time Food Delivery Analytics Platform
#  Copy this file to .env and fill in values.
# ─────────────────────────────────────────────

# ── Simulator ──────────────────────────────
EVENTS_PER_SECOND=500
DUPLICATE_RATE=0.02
LATE_EVENT_RATE=0.03
OUT_OF_ORDER_RATE=0.02
BAD_RECORD_RATE=0.01
SCHEMA_DRIFT_RATE=0.005
CHAOS_MODE=true

# ── Kafka ──────────────────────────────────
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC_ORDERS=orders.events
KAFKA_TOPIC_DLQ=dlq.events
KAFKA_TOPIC_RESTAURANTS=restaurants.master

# ── MinIO / S3 ─────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_LAKE_BUCKET=lake
S3_CHECKPOINT_BUCKET=checkpoints

# ── Spark ──────────────────────────────────
SPARK_MASTER=spark://spark-master:7077
SPARK_SHUFFLE_PARTITIONS=8
MAX_OFFSETS_PER_TRIGGER=200000
TRIGGER_INTERVAL=10 seconds
WATERMARK_DURATION=15 minutes

# ── Airflow ────────────────────────────────
AIRFLOW__CORE__FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ── PostgreSQL ─────────────────────────────
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Alerts (optional) ──────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_EMAIL=your@email.com
